  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">ReachscopeMain – reach & direct-path checker</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject counter {"hint":"Counter root. Its origin is the center of the countertop surface (world Y = countertop height)."}'
    - '// @input SceneObject referenceMarker {"hint":"Fixed reach reference marker (not movable). Its world position is the path start."}'
    - '// @input AssignableType_1 assistanceButton {"hint":"Draggable assistance button."}'
    - '// @input AssignableType_2 divider {"hint":"Draggable divider panel."}'
    - '// @input AssignableType_3 pathLine {"hint":"Path line renderer."}'
    - '// @input AssignableType_4 statusLabel {"hint":"Status label UI module."}'
    - '// @input AssignableType_5 resetButton {"hint":"Reset button UI module."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float maxReachCm = 65 {"hint":"Reach limit in cm. Distance strictly greater than this reads TOO FAR (illustrative, not clinical).", "widget":"slider", "min":30, "max":100, "step":0.5}'
    - '// @input vec2 counterSizeCm = {100,70} {"hint":"Countertop width (X) and depth (Z) in cm — used to keep dragged objects on the counter."}'
    - '// @input vec2 dividerFootprintCm = {20,2} {"hint":"Divider footprint: width across the path (X) and thickness (Z), in cm."}'
    - '// @input float buttonRadiusCm = 4 {"hint":"Assistance button radius in cm (keeps the whole button on the counter).", "widget":"slider", "min":1, "max":10, "step":0.5}'
    - '// @input float lineWidthCm = 0.6 {"hint":"Normal path line width in cm (BLOCKED / CLEAR).", "widget":"slider", "min":0.1, "max":3, "step":0.05}'
    - '// @input float thinLineWidthCm = 0.35 {"hint":"Thin line width in cm used for TOO FAR.", "widget":"slider", "min":0.1, "max":3, "step":0.05}'
    - '// @input float grabWidthMultiplier = 1.8 {"hint":"Width multiplier while the button or divider is grabbed.", "widget":"slider", "min":1, "max":4, "step":0.1}'
    - '// @input vec4 blockedColor = "{1, 0.32, 0.3, 1}" {"hint":"PATH BLOCKED color (line + label).", "widget":"color"}'
    - '// @input vec4 clearColor = "{0.35, 1, 0.45, 1}" {"hint":"DIRECT PATH CLEAR color (line + label).", "widget":"color"}'
    - '// @input vec4 tooFarColor = "{1, 0.72, 0.2, 1}" {"hint":"TOO FAR color (line + label).", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Debug"}'
    - '// @input bool debugSelfTest {"hint":"DEBUG ONLY (default off). Moves button/divider through the drag code path to exercise every verdict; verdicts still come from live transforms."}'
    - '// @ui {"widget":"group_end"}'
